+/** `sor terminal` cevabı: dürüst — terminal kapalıysa okunmuş gibi yapılmaz. Çerçeve İngilizce (spec 06 §6.8). */
+export function terminalCevabi(t: { satirlar: string; kod?: number } | null): { metin: string; maliyet: number; kirpildi: boolean } {
+  const SINIR = 1200;
+  if (!t) return { metin: "Ozyn's terminal is not open; there is nothing to read.", maliyet: 0, kirpildi: false };
+  const satirlar = t.satirlar.trimEnd();
+  const kirpildi = satirlar.length > SINIR;
+  const govde = kirpildi ? satirlar.slice(satirlar.length - SINIR) : satirlar;
+  const kod = t.kod === undefined ? "" : ` (last exit code ${t.kod})`;
+  const metin = govde ? `Last lines of Ozyn's terminal${kod}:\n${govde}` : `Ozyn's terminal is empty${kod}.`;
+  return { metin, maliyet: metin.length, kirpildi };
+}
